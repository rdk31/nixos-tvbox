Restore CoreELEC's interrupt settings for Ugoos AM9 firmware before 2.2.0.
Without these overrides the older bootloader delivers no display vsync or
I2C interrupts, leaving Kodi waiting on DRM fences and the audio codec absent.

Upstream: https://github.com/CoreELEC/common_drivers/commit/8a0ab5f1a22d1b8f5d0c75f4a82da8a30ee50a53
The upstream revert (225320b0c54f616739a6da4562b0d18e05ebe51b)
targets firmware 2.2.0; this board still uses the older stock bootloader.

diff --git a/common_drivers/arch/arm64/boot/dts/amlogic/coreelec_s6_common.dtsi b/common_drivers/arch/arm64/boot/dts/amlogic/coreelec_s6_common.dtsi
--- a/common_drivers/arch/arm64/boot/dts/amlogic/coreelec_s6_common.dtsi
+++ b/common_drivers/arch/arm64/boot/dts/amlogic/coreelec_s6_common.dtsi
@@ -115,6 +115,79 @@
 		      <0x0 0xfe084000 0x0 0x58>; /*Legacy IR controller*/
 		interrupts = <GIC_SPI 80 IRQ_TYPE_EDGE_RISING>;
 	};
+
+	drm_vpu: drm-vpu@0xff900000  {
+		interrupts = <GIC_SPI 197 IRQ_TYPE_EDGE_RISING>,
+				<GIC_SPI 194 IRQ_TYPE_EDGE_RISING>;
+	};
+
+	aml_watermark {
+		interrupts = <GIC_SPI 197 IRQ_TYPE_EDGE_RISING>; //=viu-vsync
+	};
+
+	soc {
+		apb4: apb4@fe000000 {
+			i2c0: i2c@66000 {
+				interrupts = <GIC_SPI 160 IRQ_TYPE_EDGE_RISING>;
+			};
+
+			i2c1: i2c@66400 {
+				interrupts = <GIC_SPI 161 IRQ_TYPE_EDGE_RISING>;
+			};
+
+			i2c2: i2c@66800 {
+				interrupts = <GIC_SPI 162 IRQ_TYPE_EDGE_RISING>;
+			};
+
+			i2c3: i2c@66c00 {
+				interrupts = <GIC_SPI 163 IRQ_TYPE_EDGE_RISING>;
+			};
+
+			i2c4: i2c@67000 {
+				interrupts = <GIC_SPI 164 IRQ_TYPE_EDGE_RISING>;
+			};
+
+			i2c5: i2c@67400 {
+				interrupts = <GIC_SPI 165 IRQ_TYPE_EDGE_RISING>;
+			};
+		};
+	};
+
+	vdec {
+		interrupts = <0 3 1
+			0 23 1
+			0 32 1
+			0 91 1
+			0 92 1
+			0 93 1
+			0 72 1>;
+	};
+
+	amhdmitx: amhdmitx{
+		interrupts = <GIC_SPI 204 IRQ_TYPE_LEVEL_HIGH
+			GIC_SPI 197 IRQ_TYPE_EDGE_RISING>;
+	};
+
+	rdma {
+		interrupts = <GIC_SPI 215 IRQ_TYPE_EDGE_RISING>;
+	};
+
+	multi-di {
+		interrupts = <0 203 1
+				0 202 1>;
+	};
+
+	meson-amvideom {
+		interrupts = <GIC_SPI 197 IRQ_TYPE_EDGE_RISING>;
+	};
+
+	ge2d {
+		interrupts = <GIC_SPI 217 IRQ_TYPE_EDGE_RISING>;
+	};
+
+	amlgdc {
+		interrupts = <GIC_SPI 147 IRQ_TYPE_EDGE_RISING>;
+	};
 };
 
 &ion_cma_reserved {
