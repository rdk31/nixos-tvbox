 void AmlogicGrabber::loadLutFile(PixelFormat color)
 {
+	QString userLut = QString("%1/lut_lin_tables.3d").arg(_configurationPath);
+	QString sharedLut = QString("%1/lut_lin_tables.3d").arg(GetSharedLut());
+
+	const int activeMode = _hdrToneMappingEnabled;
+	_hdrToneMappingEnabled = 1;
+	Grabber::loadLutFile(_log, color, QList<QString>{userLut, sharedLut});
+	_hdrToneMappingEnabled = activeMode;
 }
 
 void AmlogicGrabber::setHdrToneMappingEnabled(int mode)
 {
+	const bool configured = mode != 0;
+	if (_hdrToneMappingConfigured != configured || (_lut.data() == nullptr && configured))
+	{
+		_hdrToneMappingConfigured = configured;
+
+		if (configured && _lut.data() == nullptr)
+			loadLutFile(PixelFormat::RGB24);
+		updateHdrToneMappingForSource();
+		emit SignalSetNewComponentStateToAllInstances(
+			hyperhdr::Components::COMP_HDR,
+			configured);
+	}
+	else
+	{
+		Debug(_log, "HDR tone mapping configuration unchanged: {:s}", configured ? "Enabled" : "Disabled");
+	}
+}
+
+bool AmlogicGrabber::isHdrOutput()
+{
+	QFile status(HDMI_HDR_STATUS);
+	if (!status.open(QIODevice::ReadOnly))
+		return false;
+
+	const QByteArray value = status.readAll().trimmed();
+	return !value.isEmpty() && value != "SDR";
+}
+
+void AmlogicGrabber::updateHdrToneMappingForSource()
+{
+	const int active = (_hdrToneMappingConfigured && isHdrOutput()) ? 1 : 0;
+	if (_hdrToneMappingEnabled != active)
+	{
+		_hdrToneMappingEnabled = active;
+		Info(_log, "HDR tone mapping is now {:s} for the current HDMI output", active ? "active" : "inactive");
+	}
 }
 
