+bool AmlogicGrabber::isHdrOutput()
+{
+	QFile status(HDMI_HDR_STATUS);
+	if (!status.open(QIODevice::ReadOnly))
+		return false;
+
+	const QByteArray value = status.readAll().trimmed();
+	return !value.isEmpty() && value != "SDR";
+}
+
+void AmlogicGrabber::updateHdrToneMappingForSource()
+{
+	const int active = (_hdrToneMappingConfigured && isHdrOutput()) ? 1 : 0;
+	if (_hdrToneMappingEnabled != active)
+	{
+		_hdrToneMappingEnabled = active;
+		Info(_log, "HDR tone mapping is now {:s} for the current HDMI output", active ? "active" : "inactive");
+	}
+}
