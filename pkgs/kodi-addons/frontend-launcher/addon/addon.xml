<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="script.tvbox.frontend-launcher"
       name="External frontends"
       provider-name="nixos-tvbox"
       version="1.0.0">
  <requires>
    <import addon="xbmc.python" version="3.0.0"/>
  </requires>
  <extension point="xbmc.python.script" library="default.py">
    <provides>executable</provides>
  </extension>
  <extension point="xbmc.addon.metadata">
    <summary lang="en_GB">Launch an external TV frontend</summary>
    <description lang="en_GB">Select a configured frontend, leave Kodi, and return when it exits.</description>
    <platform>all</platform>
    <license>MIT</license>
  </extension>
</addon>
